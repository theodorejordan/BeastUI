---
import Docs from '../layouts/Docs.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Docs title="BeastUI" description="A calm, outlined UI system.">
  <h1>BeastUI</h1>
  <p class="docs-lead">A calm, outlined UI system. Tokens, plain CSS classes, and thin Preact components.</p>
  <h2>Components</h2>
  <ul>
    <li><a href={`${base}components/button/`}>Button</a></li>
    <li><a href={`${base}components/segmented-control/`}>Segmented control</a></li>
    <li><a href={`${base}components/field/`}>Field</a></li>
    <li><a href={`${base}components/checkbox/`}>Checkbox</a></li>
    <li><a href={`${base}components/tag/`}>Tag</a></li>
    <li><a href={`${base}components/table/`}>Table</a></li>
    <li><a href={`${base}components/tree/`}>Tree</a></li>
  </ul>
</Docs>

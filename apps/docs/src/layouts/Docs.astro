---
// BeastUI first, then the docs' own layer: the order an app follows (03-architecture §7).
import '@beastui/css/beastui.css';
import '../styles/docs.css';
// Fonts are loaded by the app, not by @beastui/css: only the weights the tokens use.
import '@fontsource/inter-tight/latin-400.css';
import '@fontsource/inter-tight/latin-500.css';
import '@fontsource/outfit/latin-300.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import ThemeSwitcher from '../components/ThemeSwitcher';
import DocsMenu from '../components/DocsMenu.astro';

interface Props {
  title?: string;
  description?: string;
  // MDX pages that name this layout pass their frontmatter instead, and their headings.
  frontmatter?: { title: string; description?: string };
  headings?: { depth: number; slug: string; text: string }[];
}
const title = Astro.props.frontmatter?.title ?? Astro.props.title ?? 'BeastUI';
const description = Astro.props.frontmatter?.description ?? Astro.props.description;
const home = import.meta.env.BASE_URL;
// "On this page": the chapters (h2) and their sections (h3).
const toc = (Astro.props.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
// The menu: every component page, A–Z, read from the pages themselves so a new page joins it.
const pages = Object.values(
  import.meta.glob<{ frontmatter: { title: string }; url: string }>('../pages/components/*.mdx', { eager: true }),
);
const components = pages
  .map((p) => ({ title: p.frontmatter.title, url: `${p.url}/` }))
  .sort((a, b) => a.title.localeCompare(b.title));
const here = Astro.url.pathname.replace(/\/?$/, '/');
const menu = [
  { title: 'Start', links: [{ title: 'Introduction', url: home }] },
  { title: 'Components', links: components },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'BeastUI' ? title : `${title} · BeastUI`}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Apply the remembered theme before the first paint (key shared with ThemeSwitcher.tsx).
      try {
        const saved = JSON.parse(localStorage.getItem('beastui-docs') ?? 'null');
        if (saved?.theme && saved.theme !== 'core') document.documentElement.dataset.theme = saved.theme;
        if (saved?.mode && saved.mode !== 'system') document.documentElement.dataset.mode = saved.mode;
      } catch {}
    </script>
  </head>
  <body>
    <header class="docs-bar">
      <button class="b-btn docs-menu-open" data-variant="quiet" data-icon type="button" aria-label="Menu" aria-haspopup="dialog">
        <svg class="b-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
      <a class="docs-mark" href={home}>BeastUI</a>
      <ThemeSwitcher client:load />
    </header>
    <div class="docs-page">
      <nav class="docs-nav" aria-label="Docs">
        <DocsMenu groups={menu} here={here} />
      </nav>
      <main class="docs-main">
        <slot />
      </main>
      {
        toc.length > 0 && (
          <aside class="docs-toc">
            <nav aria-label="On this page">
              <p class="docs-toc__title">On this page</p>
              <ul>
                {toc.map((h) => (
                  <li data-depth={h.depth}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
    <dialog class="docs-drawer" aria-label="Docs">
      <div class="docs-drawer__body">
        <div class="docs-drawer__head">
          <a class="docs-mark" href={home}>BeastUI</a>
          <button class="b-btn docs-menu-close" data-variant="quiet" data-icon type="button" aria-label="Close menu">
            <svg class="b-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </div>
        <nav class="docs-nav__list" aria-label="Docs">
          <DocsMenu groups={menu} here={here} />
        </nav>
      </div>
    </dialog>
    <script>
      // Small screens: the menu opens in a modal <dialog>, which brings Esc, focus kept inside
      // and the inert page for free. A click on the backdrop (the dialog itself) closes it too.
      const drawer = document.querySelector<HTMLDialogElement>('.docs-drawer');
      document.querySelector('.docs-menu-open')?.addEventListener('click', () => drawer?.showModal());
      document.querySelector('.docs-menu-close')?.addEventListener('click', () => drawer?.close());
      drawer?.addEventListener('click', (e) => {
        if (e.target === drawer) drawer.close();
      });
      // The layout slides between widths only once the page is drawn (docs.css, Motion): not
      // on load, where the menus would slide in on every page.
      requestAnimationFrame(() => requestAnimationFrame(() => (document.documentElement.dataset.motion = '')));
      // Back to a wide screen with the drawer open: the left column takes over.
      matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
        if (e.matches) drawer?.close();
      });
    </script>
    <script>
      // Marks the section being read in "On this page" (aria-current), from the last heading
      // that scrolled past the top third of the screen.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.docs-toc a')];
      const headings = links
        .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
        .filter((h): h is HTMLElement => h !== null);
      const mark = (): void => {
        const line = window.innerHeight / 3;
        let current = headings[0];
        for (const h of headings) if (h.getBoundingClientRect().top <= line) current = h;
        // At the very bottom, the last section is the one being read, however short.
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
          current = headings[headings.length - 1];
        }
        for (const a of links) {
          const on = current !== undefined && a.hash === `#${current.id}`;
          if (on) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        }
        // Keeps the marked link in view when the menu is longer than the screen. Scrolls the
        // menu only: scrollIntoView() would move the page too.
        const menu = document.querySelector<HTMLElement>('.docs-toc');
        const link = links.find((a) => a.hasAttribute('aria-current'));
        if (menu && link) {
          const top = link.getBoundingClientRect().top - menu.getBoundingClientRect().top + menu.scrollTop;
          if (top < menu.scrollTop) menu.scrollTop = top;
          else if (top + link.offsetHeight > menu.scrollTop + menu.clientHeight) {
            menu.scrollTop = top + link.offsetHeight - menu.clientHeight;
          }
        }
      };
      if (headings.length) {
        let queued = false;
        addEventListener(
          'scroll',
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              mark();
            });
          },
          { passive: true },
        );
        mark();
      }
    </script>
  </body>
</html>

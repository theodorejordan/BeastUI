{
  "name": "beastui-workspace",
  "private": true,
  "type": "module",
  "description": "BeastUI: a calm, outlined UI system. Workspace root, not published.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "pnpm --recursive --filter './packages/*' run build",
    "dev:docs": "pnpm --filter docs dev",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive --filter './packages/*' run test",
    "test:e2e": "pnpm --filter docs test:e2e",
    "check:packages": "node scripts/check-packages.mjs",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "browserslist": [
    "safari >= 17.5",
    "ios_saf >= 17.5",
    "chrome >= 125",
    "edge >= 125",
    "firefox >= 126"
  ],
  "volta": {
    "node": "22.23.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "3.0.3",
    "publint": "^0.3.25"
  }
}

      "light": {
        "$description": "A group's name in a list (menu, select): lighter than the rows it names.",
        "$value": 300
      },
      "display": {
        "$value": 300
      },
      "current": {
        "$description": "The chosen row's name (tree, aria-current): regular where the bold edge marks it, medium where a theme drops the edge.",
        "$value": "{font.weight.regular}"
      }

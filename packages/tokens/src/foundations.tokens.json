        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "4": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "5": {
        "$value": {
          "value": 32,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "$type": "dimension",
      "0": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "1": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "2": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "3": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "4": {
        "$value": {
          "value": 28,

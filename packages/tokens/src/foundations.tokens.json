{
  "$description": "BeastUI foundations (docs/ui-system/04-foundations.md). Core values; layers override some of them.",
  "space": {
    "$type": "dimension",
    "$description": "One 4px grid (§2). The name is the multiple of 4: space.3 = 12px. Half steps only inside small controls and for the icon gap.",
    "0-5": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "1-5": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "12": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "gap": {
    "$type": "dimension",
    "$description": "Proximity ladder (§3): the space inside a group is always smaller than the space around it.",
    "row": {
      "$description": "Between the rows of a list (tree, menu, select list): 1px, so two tinted rows (the chosen one and its parent, or a hovered one) stay two. A theme with round rows opens it more.",
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "hint": {
      "$value": "{space.1}"
    },
    "icon": {
      "$value": "{space.1-5}"
    },
    "field": {
      "$value": "{space.2}"
    },
    "choice": {
      "$value": "{space.2}"
    },
    "inline": {
      "$value": "{space.2}"
    },
    "stack": {
      "$value": "{space.4}"
    },
    "group": {
      "$value": "{space.6}"
    },
    "section": {
      "$value": "{space.12}"
    }
  },
  "size": {
    "$type": "dimension",
    "$description": "Sizes (§1): one control height per density, small and large one step away.",
    "control": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "step": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "row": {
      "$value": {
        "value": 36,
        "unit": "px"
      }
    },
    "badge": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "glyph": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "glyph-lg": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "inset": {
    "$type": "dimension",
    "$description": "Insets (§8). Text is measured from the outer edge, empty bands from the border's inner edge.",
    "control": {
      "$value": "{space.3}"
    },
    "nested": {
      "$value": "{space.1}"
    },
    "panel": {
      "$value": "{space.4}"
    },
    "dialog": {
      "$value": "{space.6}"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Radius by size (§4); nested corners are computed in the component CSS, never picked.",
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "control": {
      "$value": "{radius.2}"
    },
    "check": {
      "$value": "{radius.1}"
    },
    "row": {
      "$description": "A list row's corners (tree): square, rows sit edge to edge like the table's.",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "tag": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "line": {
    "$type": "dimension",
    "$description": "Three widths and no others (§7).",
    "hair": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "stroke": {
      "$value": {
        "value": 1.5,
        "unit": "px"
      }
    },
    "bold": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "current": {
      "$description": "The edge that marks the chosen row of a list (tree, aria-current): the bold line. A theme with round rows drops it (0) and marks the row with --b-font-weight-current instead.",
      "$value": "{line.bold}"
    }
  },
  "blur": {
    "$type": "dimension",
    "$description": "The blur behind a modal or a drawer: just enough to set the page back, the page still recognisable (owner, 2026-11-25).",
    "backdrop": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "width": {
    "$type": "dimension",
    "$description": "Widths of floating things, on the grid (§11).",
    "menu": {
      "$value": {
        "value": 224,
        "unit": "px"
      }
    },
    "toast": {
      "$value": {
        "value": 360,
        "unit": "px"
      }
    },
    "drawer": {
      "$value": {
        "value": 360,
        "unit": "px"
      }
    },
    "dialog": {
      "$value": {
        "value": 400,
        "unit": "px"
      }
    }

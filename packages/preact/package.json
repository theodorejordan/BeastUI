{
  "name": "@beastui/preact",
  "version": "0.0.0",
  "description": "BeastUI for Preact: thin components that add behaviour to @beastui/css. No visual rule lives in JS.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/button.tsx",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./button": {
        "types": "./dist/button.d.ts",
        "default": "./dist/button.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@beastui/css": "workspace:^",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@beastui/css": "workspace:*",
    "browserslist": "^4.29.6",
    "preact": "^11.2.0",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  }
}

{
  "name": "@beastui/css",
  "version": "0.0.0",
  "description": "BeastUI components as plain CSS classes, zero JS, inside BeastUI's cascade layers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodorejordan/BeastUI.git",
    "directory": "packages/css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./beastui.css": "./src/beastui.css",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./components/*.css": "./src/components/*.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./beastui.css": "./dist/beastui.css",
      "./tokens.css": "./dist/tokens.css",
      "./base.css": "./dist/base.css",
      "./components/*.css": "./dist/components/*.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@beastui/tokens": "workspace:*",
    "@vitest/browser-playwright": "^5.1.1",
    "browserslist": "^4.29.6",
    "lightningcss": "^1.33.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
